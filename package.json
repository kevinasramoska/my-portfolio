{
  "name": "my-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --omit=dev --audit-level=high",
    "check": "npm run resume:check && npm run lint && npm run typecheck && npm run build",
    "test:e2e": "playwright test",
    "resume:build": "node scripts/build-resume.mjs",
    "resume:check": "node scripts/build-resume.mjs --check"
  },
  "dependencies": {
    "lucide-react": "^1.57.0",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2"
  }
}
